---
/**
 * Metadata framework. Every page passes title + description; everything else
 * (canonical, Open Graph, Twitter/X, JSON-LD) is derived here so no page can forget it.
 */
import { site } from '../data/site';
import { organization, website } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  published?: Date;
  updated?: Date;
}

const { title, description, image = site.defaultOgImage, type = 'website', schema = [], noindex = false, published, updated } = Astro.props;

const isHome = ['/', '/index.html'].includes(Astro.url.pathname);
const fullTitle = isHome ? `${site.name} | EEG testing and education` : `${title} | ${site.name}`;
// Clean canonical: no ".html", no trailing slash (matches sitemap and redirect plan).
const cleanPath = Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(cleanPath, site.url).toString();
const imageUrl = new URL(image, site.url).toString();

const graph = { '@context': 'https://schema.org', '@graph': [organization(), website(), ...schema] };
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
{published && <meta property="article:published_time" content={published.toISOString()} />}
{updated && <meta property="article:modified_time" content={updated.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={site.social.twitter} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<link rel="sitemap" href="/sitemap-index.xml" />
<script type="application/ld+json" set:html={JSON.stringify(graph)} />
